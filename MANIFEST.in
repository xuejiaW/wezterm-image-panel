include README.md VALIDATION.md CHANGELOG.md CONTRIBUTING.md SECURITY.md
include wezterm-image-panel wezterm_integration.lua preview.wezterm.lua
include test_*.py
recursive-include docs *.md
recursive-include examples *.py *.lua
recursive-include scripts *.py *.lua
prune .codex-local
prune evidence
prune .github
prune .venv
prune __pycache__
global-exclude *.py[cod] *.jsonl *.sqlite *.sqlite-* *.log .DS_Store
