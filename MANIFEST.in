include README.md CHANGELOG.md CONTRIBUTING.md SECURITY.md
recursive-include src *.py *.lua
recursive-include integrations *.lua
recursive-include tests *.py
recursive-include docs *.md
recursive-include examples *.py *.lua
recursive-include scripts *.py *.lua
prune .codex-local
prune evidence
prune .github
prune .venv
prune __pycache__
global-exclude *.py[cod] *.jsonl *.sqlite *.sqlite-* *.log .DS_Store
